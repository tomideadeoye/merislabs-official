{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@/components/*": ["./app/components/*"],
      "@/lib/*": ["./app/lib/*"],
      "@/hooks/*": ["./app/hooks/*"],
      "@/generated": ["generated/index.d.ts"],
      "@/generated/*": ["generated/*"],
      "@/types/*": ["./app/lib/types/*"],
      "@/utils/*": ["./app/lib/utils/*"],
      "@/stores/*": ["./app/lib/stores/*"],
      "@/styles/*": ["./app/styles/*"],
      "@/css/*": ["./app/css/*"],
      "@/public/*": ["./public/*"],
      "@/api/*": ["./app/api/*"],
      "@/database/*": ["./app/database/*"],
      "@/state/*": ["./app/state/*"],
      "@/memory-explorer/*": ["./app/memory-explorer/*"],
      "@/opportunity/*": ["./app/opportunity/*"],
      "@/wallpaper-generator/*": ["./app/wallpaper-generator/*"],
      "@/journal/*": ["app/api/orion/journal/*"],
      "@/decks/*": ["./decks/*"],
      "@/fonts/*": ["./app/fonts/*"],
      "@/global-error": ["./app/global-error"],
      "@/globals": ["./app/globals"],
      "@/fonts": ["./app/fonts"],
      "@/layout": ["./app/layout"],
      "@/page": ["./app/page"],
      "@/not-found": ["./app/not-found"]
    },
    "checkJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "components/orion/EmotionalLogHistory.jsx"
  ],
  "exclude": ["node_modules", "**/node_modules/*"]
}
