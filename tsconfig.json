{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"],
      "@/components/*": ["./app/components/*"],
      "@/lib/*": ["./app/lib/*"],
      "@/hooks/*": ["./app/hooks/*"],
      "@/generated": ["generated/index.d.ts"],
      "@/generated/*": ["generated/*"],
      "@/ui/*": ["./app/components/ui/*"],
      "@/types/*": ["./app/lib/types/*"],
      "@/utils/*": ["./app/lib/utils/*"],
      "@/stores/*": ["./app/lib/stores/*"],
      "@/styles/*": ["./app/styles/*"],
      "@/css/*": ["./app/css/*"],
      "@/public/*": ["./public/*"],
      "@/api/*": ["./app/api/*"],
      "@/database/*": ["./app/database/*"],
      "@/state/*": ["./app/state/*"],
      "@/memory-explorer/*": ["./app/memory-explorer/*"],
      "@/opportunity/*": ["./app/opportunity/*"],
      "@/wallpaper-generator/*": ["./app/wallpaper-generator/*"],
      "@/journal/*": ["app/api/orion/journal/*"],
      "@/decks/*": ["./decks/*"],
      "@/fonts/*": ["./app/fonts/*"],
      "@/global-error": ["./app/global-error"],
      "@/globals": ["./app/globals"],
      "@/fonts": ["./app/fonts"],
      "@/layout": ["./app/layout"],
      "@/page": ["./app/page"],
      "@/not-found": ["./app/not-found"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "api/**/*.ts",
    "api/**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.tsx",
    "prisma/**/*.ts",
    "scripts/**/*.ts",
    "docs/**/*.ts",
    "docs/**/*.tsx",
    "data/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build",
    "coverage",
    "*.config.js",
    "*.config.mjs",
    "orion_python_backend/**/*",
    "venv/**/*",
    "logs/**/*",
    "build-log.txt"
  ]
}
