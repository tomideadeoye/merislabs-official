generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Opportunity {
  id                     String               @id @default(uuid()) @db.Uuid
  title                  String
  company                String?
  type                   OpportunityType?
  status                 OpportunityStatus?
  content                String?              @map("description")
  url                    String?
  tags                   String[]             @map("requirements")
  dateIdentified         DateTime?            @map("date_identified") @db.Timestamptz(6)
  notes                  String?
  contactPerson          String?              @map("contact_person")
  contactEmail           String?              @map("contact_email")
  stage                  String?
  attachments            String[]
  relatedEvaluationId    String?              @map("related_evaluation_id") @db.Uuid
  sourceUrl              String?              @map("source_url")
  nextActionDate         DateTime?            @map("next_action_date") @db.Timestamptz(6)
  priority               OpportunityPriority?
  tailoredCv             String?              @map("tailored_cv")
  deadline               DateTime?            @map("deadline") @db.Timestamptz(6)
  location               String?
  salary                 String?
  contact                String?
  position               String?
  lastStatusUpdate       DateTime?            @map("last_status_update") @db.Timestamptz(6)
  notionPageId           String?              @map("notion_page_id")
  applicationMaterialIds String[]             @default([])
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  evaluationResult       Json?
  tailoredCvId           String?
  userId                 String?
  applicationDrafts      ApplicationDraft[]
  stakeholders           Stakeholder[]

  @@map("opportunities")
}

model Stakeholder {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  name          String
  title         String
  email         String?
  linkedinUrl   String?     @map("linkedin_url")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("stakeholders")
}

model ApplicationDraft {
  id            String      @id @default(uuid()) @db.Uuid
  opportunityId String      @map("opportunity_id") @db.Uuid
  type          String
  content       String
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("application_drafts")
}

model Prompt {
  id        String   @id @default(uuid()) @db.Uuid
  uniqueId  String   @unique
  name      String
  content   String
  category  String?
  userId    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("prompts")
}

model EmotionalLogs {
  id                          String  @id @default(uuid())
  timestamp                   String
  primaryEmotion              String
  secondaryEmotions           String?
  intensity                   Int
  triggers                    String?
  physicalSensations          String?
  accompanyingThoughts        String
  copingMechanismsUsed        String?
  contextualNote              String?
  relatedJournalSourceId      String?
  cognitiveDistortionAnalysis String?
  emotion                     String
  context                     String

  @@map("emotional_logs")
}

model HabiticaTaskLink {
  id                     String   @id @default(uuid())
  habiticaTaskId         String
  orionSourceModule      String
  orionSourceReferenceId String
  orionTaskText          String
  createdAt              DateTime @default(now())

  @@map("habitica_task_links")
}

model Idea {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      IdeaStatus    @default(raw_spark)
  tags        String[]      @default([])
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  dueDate     DateTime?     @map("due_date") @db.Timestamptz(6)
  priority    IdeaPriority?
  userId      String?
  logs        IdeaLog[]

  @@map("ideas")
}

model IdeaLog {
  id        String   @id @default(uuid()) @db.Uuid
  ideaId    String   @map("idea_id") @db.Uuid
  timestamp DateTime @default(now())
  logType   String   @map("log_type")
  details   String
  action    String
  type      String
  content   String?
  author    String?
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@map("idea_logs")
}

model CVComponent {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  type      String
  content   Json
  tags      String[] @default([])
  userId    String
  uniqueId  String?  @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("cv_components")
}

model CVFeedback {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String
  opportunityId    String   @db.Uuid
  feedbackType     String
  feedbackDetails  String
  componentId      String?  @db.Uuid
  originalContent  String?
  generatedContent String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("cv_feedback")
}

model LlmSettings {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique
  globalDefaultModel   String?
  requestTypeOverrides Json?
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("llm_settings")
}

model JournalEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  date      DateTime
  content   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("journal_entries")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String
  title       String
  description String?      @default("")
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  type        TaskType     @default(TODO)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  steps       TaskStep[]

  @@map("tasks")
}

model TaskStep {
  id                  String   @id @default(uuid()) @db.Uuid
  taskId              String   @map("task_id") @db.Uuid
  stepNumber          Int      @map("step_number")
  prompt              String
  generatedOptions    Json     @map("generated_options")
  chosenAction        String?  @map("chosen_action")
  chosenJustification String?  @map("chosen_justification")
  toolCalls           Json?    @map("tool_calls")
  memoryReferences    Json?    @map("memory_references")
  relatedLinks        Json?    @map("related_links")
  relatedPhoneNumbers Json?    @map("related_phone_numbers")
  finalLog            Json?    @map("final_log")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_steps")
}

model UserDefinedTool {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  name        String   @unique
  description String
  parameters  Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  apiEndpoint String

  @@map("user_defined_tools")
}

model UserProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique
  name              String?
  email             String?
  mobile            String?
  website           String?
  github            String?
  linkedin          String?
  substack          String?
  slideshare        String?
  medium            String?
  discord           String?
  merisLabsLinkedin String?
  bioPitchLink      String?
  youtube           String?
  language          String?
  location          String?
  profileText       String
  lastFetchedAt     DateTime? @map("last_fetched_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_profiles")
}

enum OpportunityType {
  job
  project
  collaboration
  gig
  other
  educationProgram
  projectCollaboration
  funding
  negotiating
  declined
  applicationReady
  outreachPlanned
  outreachSent
  offerReceived
}

enum OpportunityStatus {
  IDENTIFIED
  RESEARCHING
  APPLYING
  INTERVIEWING
  OFFERED
  REJECTED
  ACCEPTED
  ARCHIVED
  EVALUATING
  EVALUATED_POSITIVE            @map("evaluatedPositive")
  EVALUATED_NEGATIVE            @map("evaluatedNegative")
  APPLICATION_DRAFTING          @map("applicationDrafting")
  INTERVIEW_SCHEDULED           @map("interviewScheduled")
  INTERVIEW_COMPLETED           @map("interviewCompleted")
  APPLIED
  PURSUING
  NEGOTIATING
  DECLINED
  APPLICATION_READY             @map("applicationReady")
  OUTREACH_PLANNED              @map("outreachPlanned")
  OUTREACH_SENT                 @map("outreachSent")
  FOLLOW_UP_NEEDED              @map("followUpNeeded")
  FOLLOW_UP_SENT                @map("followUpSent")
  OFFER_RECEIVED                @map("offerReceived")
  APPLYING_NEXT_STEP            @map("applyingNextStep")
  INTERVIEWING_ROUND_1          @map("interviewingRound1")
  INTERVIEWING_ROUND_2          @map("interviewingRound2")
  FINAL_INTERVIEW               @map("finalInterview")
  OFFER_RECEIVED_PENDING_REVIEW @map("offerReceivedPendingReview")
  OFFER_ACCEPTED                @map("offerAccepted")
  OFFER_REJECTED                @map("offerRejected")
  ACTIVE_OUTREACH               @map("activeOutreach")
  FOLLOW_UP
  ON_HOLD                       @map("onHold")
  CONVERTED
  REJECTED_BY_THEM              @map("rejectedByThem")
  DECLINED_BY_ME                @map("declinedByMe")
}

enum OpportunityPriority {
  HIGH
  MEDIUM
  LOW
}

enum IdeaStatus {
  raw_spark
  NEW
  researching
  developing
  launched
  abandoned
}

enum IdeaPriority {
  high
  medium
  low
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskType {
  TODO
  DAILY
  HABIT
  REWARD
  PROJECT
  GOAL
}
